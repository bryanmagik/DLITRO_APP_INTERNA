{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dlitro",
  "version": "0.2.6",
  "identifier": "cl.dlitro.tomapedidos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev:staging",
    "beforeBuildCommand": "npm run build:production"
  },
  "app": {
    "windows": [
      {
        "title": "dlitro — Toma de Pedidos",
        "width": 1200,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGOTMyOTRDOEVDRDhCODAKUldTQWk4Mk9UQ21Udi9PNTVHR3EzdmNYK0pBZmdEYS80SUd0UWtYM0xIbjFQM0lLcEl5V21rT2sK",
      "endpoints": [
        "https://github.com/bryanmagik/DLITRO_APP_INTERNA/releases/latest/download/latest.json"
      ]
    }
  }
}
